# Port the API listens on
PORT=4000

# Secret used to sign JWTs — replace with a long random string in production
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=30d

# Comma-separated list of origins allowed to call the API (your frontend's URL)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Max size for uploaded images/attachments (bytes) — default 15 MB
MAX_UPLOAD_BYTES=15728640
